# Local-only Meshy key for Batch 3B secret upload.
# Copy this file to .env.meshy.local (gitignored via .env.*.local) and fill in:
#
# IMAGE_TO_3D_API_KEY=YOUR_MESHY_API_KEY
#
# Then run:
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-meshy-secrets.ps1
#
# Never commit .env.meshy.local. Never use a VITE_ variable for this key.
