# Copy to .env.local (untracked) and fill in real values.
#
# Everything below VITE_ is exposed to the browser bundle by Vite — never
# put a secret behind a VITE_ prefix. Server-only variables (no VITE_
# prefix) belong in the Supabase Edge Function / backend environment, never
# here and never in frontend code. See docs/image-to-3d-ar-plan.md for which
# side of the boundary each one lives on.

# --- Frontend (safe to expose; the anon key is designed to be public and is
# constrained entirely by the RLS policies in supabase/migrations/) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical public origin encoded into QR codes and share links.
# Production / Vercel:
#   VITE_PUBLIC_APP_URL=https://webar-poc-one.vercel.app
# LAN phone testing against `npm run dev` (use the Network HTTPS URL):
#   VITE_PUBLIC_APP_URL=https://192.168.1.207:5173
# Desktop-only local checks:
#   VITE_PUBLIC_APP_URL=http://localhost:5173
# Do not leave localhost set if you need phone-scannable QR codes.
VITE_PUBLIC_APP_URL=

# --- Server-only. Set these as Supabase Edge Function secrets (or your
# backend host's secret manager), never as VITE_ variables, never committed,
# never logged. ---
# SUPABASE_SERVICE_ROLE_KEY=
# IMAGE_TO_3D_PROVIDER=
# IMAGE_TO_3D_API_KEY=
# IMAGE_TO_3D_WEBHOOK_SECRET=
# MODEL_CONVERSION_API_KEY=
